        "liquid": "<style>\n  .lok-reviews {\n    background: #ffffff;\n    padding: 24px 20px;\n    font-family: sans-serif;\n  }\n  .lok-reviews__header {\n    text-align: center;\n    margin-bottom: 12px;\n  }\n  .lok-reviews__title {\n    text-align: center;\n    color: #0D1B4B;\n    font-size: 24px;\n    font-weight: 600;\n    margin: 0;\n    padding: 0 16px;\n    line-height: 1.3;\n  }\n  .lok-reviews__outer {\n    overflow: hidden;\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n  .lok-reviews__track {\n    display: flex;\n    gap: 16px;\n    transition: transform 0.4s ease;\n  }\n  .lok-reviews__card {\n    background: #F5F7FA;\n    border-radius: 14px;\n    padding: 16px;\n    flex: 0 0 calc(25% - 12px);\n    box-shadow: 0 2px 10px rgba(13,27,75,0.06);\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .lok-reviews__img-wrap {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    border-radius: 8px;\n    overflow: hidden;\n  }\n  .lok-reviews__img-wrap img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .lok-reviews__stars {\n    color: #F5A623;\n    font-size: 13px;\n    letter-spacing: 1px;\n  }\n  .lok-reviews__text {\n    font-size: 12px;\n    color: #4A5568;\n    line-height: 1.5;\n    flex: 1;\n    font-style: italic;\n    margin: 0;\n  }\n  .lok-reviews__author {\n    font-size: 11px;\n    font-weight: 700;\n    color: #0D1B4B;\n    margin: 0;\n  }\n  .lok-reviews__nav {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 16px;\n    margin-top: 20px;\n  }\n  .lok-reviews__btn {\n    width: 38px;\n    height: 38px;\n    border-radius: 50%;\n    border: 2px solid #1A6FE8;\n    background: #fff;\n    color: #1A6FE8;\n    font-size: 16px;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: all 0.2s;\n  }\n  .lok-reviews__btn:hover {\n    background: #1A6FE8;\n    color: #fff;\n  }\n  .lok-reviews__dots {\n    display: flex;\n    gap: 6px;\n  }\n  .lok-reviews__dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: #D0D8E8;\n    cursor: pointer;\n    transition: background 0.2s;\n  }\n  .lok-reviews__dot.active {\n    background: #1A6FE8;\n  }\n  @media screen and (max-width: 768px) {\n    .lok-reviews {\n      padding: 24px 10px;\n    }\n    .lok-reviews__title {\n      font-size: 18px;\n      margin-bottom: 12px;\n    }\n    .lok-reviews__header {\n      margin-bottom: 12px;\n    }\n    .lok-reviews__card {\n      flex: 0 0 calc(80% - 8px);\n      padding: 12px;\n      gap: 8px;\n    }\n    .lok-reviews__text {\n      font-size: 11px;\n    }\n    .lok-reviews__author {\n      font-size: 10px;\n    }\n  }\n</style>\n\n<div class=\"lok-reviews\">\n  <div class=\"lok-reviews__header\">\n    <h2 class=\"lok-reviews__title\">Des parents soulagés, des enfants libres</h2>\n  </div>\n  <div class=\"lok-reviews__outer\">\n    <div class=\"lok-reviews__track\" id=\"lokTrack\">\n\n      <div class=\"lok-reviews__card\">\n        <div class=\"lok-reviews__img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_28_juin_2026_20_05_47.webp?v=1782671311\" alt=\"Témoignage Camille\" loading=\"lazy\">\n        </div>\n        <div class=\"lok-reviews__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-reviews__text\">\"Je l'ai installé un dimanche soir. Le lundi matin j'ai vu Lucas arriver à l'école en temps réel depuis ma cuisine. J'ai pleuré de soulagement.\"</p>\n        <p class=\"lok-reviews__author\">Camille M. — Maman de Lucas, 7 ans</p>\n      </div>\n\n      <div class=\"lok-reviews__card\">\n        <div class=\"lok-reviews__img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_28_juin_2026_20_13_30.webp?v=1782671311\" alt=\"Témoignage Marie\" loading=\"lazy\">\n        </div>\n        <div class=\"lok-reviews__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-reviews__text\">\"Reçu en 3 jours, installé en 5 minutes. La boîte est soignée, le tracker clipse facilement dans la semelle. Vraiment rien à redire.\"</p>\n        <p class=\"lok-reviews__author\">Marie D. — Maman de Chloé, 6 ans</p>\n      </div>\n\n      <div class=\"lok-reviews__card\">\n        <div class=\"lok-reviews__img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_28_juin_2026_20_06_57.webp?v=1782671311\" alt=\"Témoignage Sophie\" loading=\"lazy\">\n        </div>\n        <div class=\"lok-reviews__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-reviews__text\">\"Enfin un produit qui tient ses promesses. Simple, discret, et mon fils n'a même pas réalisé qu'il l'avait dans sa chaussure.\"</p>\n        <p class=\"lok-reviews__author\">Sophie L. — Maman de Théo, 8 ans</p>\n      </div>\n\n      <div class=\"lok-reviews__card\">\n        <div class=\"lok-reviews__img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_28_juin_2026_20_09_59.webp?v=1782671311\" alt=\"Témoignage Thomas\" loading=\"lazy\">\n        </div>\n        <div class=\"lok-reviews__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-reviews__text\">\"La première fois qu'il est rentré seul de l'école j'avais la boule au ventre. Avec Lokeo j'ai suivi chaque pas sur mon téléphone. Magique.\"</p>\n        <p class=\"lok-reviews__author\">Thomas B. — Papa de Mathis, 9 ans</p>\n      </div>\n\n      <div class=\"lok-reviews__card\">\n        <div class=\"lok-reviews__img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_28_juin_2026_20_15_42.webp?v=1782671311\" alt=\"Témoignage Nicolas\" loading=\"lazy\">\n        </div>\n        <div class=\"lok-reviews__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-reviews__text\">\"Mon fils joue au foot le mercredi après-midi et je ne peux pas toujours rester. Lokeo me permet de partir travailler l'esprit tranquille.\"</p>\n        <p class=\"lok-reviews__author\">Nicolas R. — Papa de Noah, 10 ans</p>\n      </div>\n\n      <div class=\"lok-reviews__card\">\n        <div class=\"lok-reviews__img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_28_juin_2026_20_16_59.png?v=1782672011\" alt=\"Témoignage Aurélie\" loading=\"lazy\">\n        </div>\n        <div class=\"lok-reviews__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-reviews__text\">\"Il met ses chaussures chaque matin sans savoir que je peux le localiser. C'est exactement ce que je cherchais. Discret et efficace.\"</p>\n        <p class=\"lok-reviews__author\">Aurélie P. — Maman de Tom, 7 ans</p>\n      </div>\n\n      <div class=\"lok-reviews__card\">\n        <div class=\"lok-reviews__img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_28_juin_2026_20_18_17.png?v=1782672203\" alt=\"Témoignage Julie\" loading=\"lazy\">\n        </div>\n        <div class=\"lok-reviews__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-reviews__text\">\"Chaque matin je bois mon café en voyant son trajet sur l'appli. Ce petit rituel a changé mes matinées. Je ne stresse plus du tout.\"</p>\n        <p class=\"lok-reviews__author\">Julie F. — Maman de Emma, 8 ans</p>\n      </div>\n\n      <div class=\"lok-reviews__card\">\n        <div class=\"lok-reviews__img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_28_juin_2026_20_21_33.png?v=1782672274\" alt=\"Témoignage Laurent\" loading=\"lazy\">\n        </div>\n        <div class=\"lok-reviews__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-reviews__text\">\"Au début j'hésitais à le laisser rentrer seul. Maintenant il est fier de son indépendance et moi je suis sereine. On a tous les deux gagné.\"</p>\n        <p class=\"lok-reviews__author\">Laurent V. — Papa de Hugo, 9 ans</p>\n      </div>\n\n    </div>\n  </div>\n  <div class=\"lok-reviews__nav\">\n    <button class=\"lok-reviews__btn\" id=\"lokPrev\">&#8592;</button>\n    <div class=\"lok-reviews__dots\" id=\"lokDots\"></div>\n    <button class=\"lok-reviews__btn\" id=\"lokNext\">&#8594;</button>\n  </div>\n</div>\n\n<script>\n  (function() {\n    var track = document.getElementById('lokTrack');\n    var prevBtn = document.getElementById('lokPrev');\n    var nextBtn = document.getElementById('lokNext');\n    var dotsContainer = document.getElementById('lokDots');\n    var cards = track.querySelectorAll('.lok-reviews__card');\n    var total = cards.length;\n    var current = 0;\n    function getVisible() {\n      return window.innerWidth <= 768 ? 1 : 4;\n    }\n    function getPages() {\n      return Math.ceil(total / getVisible());\n    }\n    function buildDots() {\n      dotsContainer.innerHTML = '';\n      var pages = getPages();\n      for (var i = 0; i < pages; i++) {\n        var dot = document.createElement('span');\n        dot.className = 'lok-reviews__dot' + (i === current ? ' active' : '');\n        dot.setAttribute('data-index', i);\n        dot.addEventListener('click', function() {\n          current = parseInt(this.getAttribute('data-index'));\n          update();\n        });\n        dotsContainer.appendChild(dot);\n      }\n    }\n    function update() {\n      var visible = getVisible();\n      var cardWidth = cards[0].offsetWidth + 16;\n      track.style.transform = 'translateX(-' + (current * visible * cardWidth) + 'px)';\n      var dots = dotsContainer.querySelectorAll('.lok-reviews__dot');\n      dots.forEach(function(d, i) {\n        d.classList.toggle('active', i === current);\n      });\n    }\n    prevBtn.addEventListener('click', function() {\n      current = current > 0 ? current - 1 : getPages() - 1;\n      update();\n    });\n    nextBtn.addEventListener('click', function() {\n      current = current < getPages() - 1 ? current + 1 : 0;\n      update();\n    });\n    window.addEventListener('resize', function() {\n      current = 0;\n      buildDots();\n      update();\n    });\n    buildDots();\n    update();\n  })();\n</script>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
