        "liquid_R6pGJW": {
          "type": "liquid",
          "settings": {
            "liquid": "<style>\n  .lok-avis {\n    background: #ffffff;\n    padding: 24px 20px;\n    font-family: sans-serif;\n  }\n  .lok-avis__header {\n    text-align: center;\n    margin-bottom: 16px;\n  }\n  .lok-avis__title {\n    text-align: center;\n    color: #0D1B4B;\n    font-size: 24px;\n    font-weight: 600;\n    margin: 0 0 6px;\n    padding: 0 16px;\n    line-height: 1.3;\n  }\n  .lok-avis__rating {\n    font-size: 13px;\n    color: #4A5568;\n    margin: 0;\n  }\n  .lok-avis__rating strong {\n    color: #0D1B4B;\n  }\n  .lok-avis__outer {\n    overflow: hidden;\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n  .lok-avis__track {\n    display: flex;\n    gap: 16px;\n    transition: transform 0.4s ease;\n  }\n  .lok-avis__card {\n    background: #F5F7FA;\n    border-radius: 14px;\n    padding: 20px;\n    flex: 0 0 calc(33.333% - 12px);\n    box-shadow: 0 2px 10px rgba(13,27,75,0.06);\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .lok-avis__top {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n  .lok-avis__avatar {\n    width: 44px;\n    height: 44px;\n    min-width: 44px;\n    border-radius: 50%;\n    overflow: hidden;\n  }\n  .lok-avis__avatar img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .lok-avis__info {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n  }\n  .lok-avis__name {\n    font-size: 13px;\n    font-weight: 700;\n    color: #0D1B4B;\n    margin: 0;\n  }\n  .lok-avis__verified {\n    font-size: 11px;\n    color: #1A6FE8;\n    font-weight: 600;\n    margin: 0;\n  }\n  .lok-avis__stars {\n    color: #F5A623;\n    font-size: 14px;\n    letter-spacing: 1px;\n  }\n  .lok-avis__headline {\n    font-size: 13px;\n    font-weight: 700;\n    color: #0D1B4B;\n    margin: 0;\n    line-height: 1.4;\n  }\n  .lok-avis__text {\n    font-size: 12px;\n    color: #4A5568;\n    line-height: 1.6;\n    margin: 0;\n  }\n  .lok-avis__nav {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 16px;\n    margin-top: 20px;\n  }\n  .lok-avis__btn {\n    width: 38px;\n    height: 38px;\n    border-radius: 50%;\n    border: 2px solid #1A6FE8;\n    background: #fff;\n    color: #1A6FE8;\n    font-size: 16px;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: all 0.2s;\n  }\n  .lok-avis__btn:hover {\n    background: #1A6FE8;\n    color: #fff;\n  }\n  .lok-avis__dots {\n    display: flex;\n    gap: 6px;\n  }\n  .lok-avis__dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: #D0D8E8;\n    cursor: pointer;\n    transition: background 0.2s;\n  }\n  .lok-avis__dot.active {\n    background: #1A6FE8;\n  }\n  @media screen and (max-width: 749px) {\n    .lok-avis {\n      padding: 24px 10px;\n    }\n    .lok-avis__title {\n      font-size: 18px;\n    }\n    .lok-avis__card {\n      flex: 0 0 calc(85% - 8px);\n    }\n  }\n</style>\n\n<div class=\"lok-avis\">\n  <div class=\"lok-avis__header\">\n    <h2 class=\"lok-avis__title\">Ce qu'en disent les parents</h2>\n    <p class=\"lok-avis__rating\"><strong>4,9/5</strong> · Avis vérifiés</p>\n  </div>\n\n  <div class=\"lok-avis__outer\">\n    <div class=\"lok-avis__track\" id=\"lokAvisTrack\">\n\n      <div class=\"lok-avis__card\">\n        <div class=\"lok-avis__top\">\n          <div class=\"lok-avis__avatar\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/images_9.jpg?v=1782984736\" alt=\"Daris R.\">\n          </div>\n          <div class=\"lok-avis__info\">\n            <p class=\"lok-avis__name\">Daris R.</p>\n            <p class=\"lok-avis__verified\">✔ Achat vérifié</p>\n          </div>\n        </div>\n        <div class=\"lok-avis__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-avis__headline\">30 secondes d'installation. Une vie de tranquillité.</p>\n        <p class=\"lok-avis__text\">Mon fils ne s'est rendu compte de rien. Moi, je sais où il est tout le temps. J'avais essayé une montre GPS à 12€/mois avant — compliquée, et il l'enlevait tout le temps. Lokeo c'est invisible, je paie une fois, c'est tout.</p>\n      </div>\n\n      <div class=\"lok-avis__card\">\n        <div class=\"lok-avis__top\">\n          <div class=\"lok-avis__avatar\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/mon-profil-de-facebook.jpg?v=1782984742\" alt=\"Sophie M.\">\n          </div>\n          <div class=\"lok-avis__info\">\n            <p class=\"lok-avis__name\">Sophie M.</p>\n            <p class=\"lok-avis__verified\">✔ Achat vérifié</p>\n          </div>\n        </div>\n        <div class=\"lok-avis__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-avis__headline\">Le seul GPS enfant sans abonnement qui marche vraiment.</p>\n        <p class=\"lok-avis__text\">J'avais testé deux autres solutions GPS avec abonnement mensuel. Résultat : cher, et ma fille enlevait le bracelet dès qu'elle pouvait. Avec Lokeo, elle ne sait même pas que c'est là. Zéro abonnement, zéro prise de tête.</p>\n      </div>\n\n      <div class=\"lok-avis__card\">\n        <div class=\"lok-avis__top\">\n          <div class=\"lok-avis__avatar\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/images_10.jpg?v=1782984735\" alt=\"Karim B.\">\n          </div>\n          <div class=\"lok-avis__info\">\n            <p class=\"lok-avis__name\">Karim B.</p>\n            <p class=\"lok-avis__verified\">✔ Achat vérifié</p>\n          </div>\n        </div>\n        <div class=\"lok-avis__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"lok-avis__headline\">Je l'ai pris pour mes 3 enfants. Meilleur achat de l'année.</p>\n        <p class=\"lok-avis__text\">Avec n'importe quel GPS classique j'aurais payé 30€/mois pour 3 abonnements. Avec Lokeo j'ai tout équipé en une seule commande, sans abonnement. En quelques minutes c'était installé dans leurs chaussures. Énorme.</p>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"lok-avis__nav\">\n    <button class=\"lok-avis__btn\" id=\"lokAvisPrev\">&#8592;</button>\n    <div class=\"lok-avis__dots\" id=\"lokAvisDots\"></div>\n    <button class=\"lok-avis__btn\" id=\"lokAvisNext\">&#8594;</button>\n  </div>\n</div>\n\n<script>\n  (function() {\n    var track = document.getElementById('lokAvisTrack');\n    var prevBtn = document.getElementById('lokAvisPrev');\n    var nextBtn = document.getElementById('lokAvisNext');\n    var dotsContainer = document.getElementById('lokAvisDots');\n    var cards = track.querySelectorAll('.lok-avis__card');\n    var total = cards.length;\n    var current = 0;\n\n    function getVisible() {\n      return window.innerWidth <= 749 ? 1 : 3;\n    }\n\n    function getPages() {\n      return Math.ceil(total / getVisible());\n    }\n\n    function buildDots() {\n      dotsContainer.innerHTML = '';\n      var pages = getPages();\n      for (var i = 0; i < pages; i++) {\n        var dot = document.createElement('span');\n        dot.className = 'lok-avis__dot' + (i === current ? ' active' : '');\n        dot.setAttribute('data-index', i);\n        dot.addEventListener('click', function() {\n          current = parseInt(this.getAttribute('data-index'));\n          update();\n        });\n        dotsContainer.appendChild(dot);\n      }\n    }\n\n    function update() {\n      var visible = getVisible();\n      var cardWidth = cards[0].offsetWidth + 16;\n      track.style.transform = 'translateX(-' + (current * visible * cardWidth) + 'px)';\n      var dots = dotsContainer.querySelectorAll('.lok-avis__dot');\n      dots.forEach(function(d, i) {\n        d.classList.toggle('active', i === current);\n      });\n    }\n\n    prevBtn.addEventListener('click', function() {\n      current = current > 0 ? current - 1 : getPages() - 1;\n      update();\n    });\n\n    nextBtn.addEventListener('click', function() {\n      current = current < getPages() - 1 ? current + 1 : 0;\n      update();\n    });\n\n    window.addEventListener('resize', function() {\n      current = 0;\n      buildDots();\n      update();\n    });\n\n    buildDots();\n    update();\n  })();\n</script>"
          }
        }
      },
