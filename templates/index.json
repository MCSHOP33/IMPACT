        "liquid": "<section class=\"valtor-contact-simple\">\n  <div class=\"valtor-contact-container\">\n\n    <div class=\"valtor-contact-left\">\n      <div class=\"valtor-contact-icon\">💬</div>\n\n      <div>\n        <h3>Une question ? Contactez-nous</h3>\n        <p>Notre équipe est disponible pour vous répondre rapidement.</p>\n\n        <div class=\"valtor-availability\">\n          <span class=\"valtor-dot\"></span>\n          Disponible du lundi au samedi · Réponse sous 24h\n        </div>\n      </div>\n    </div>\n\n    <a href=\"/pages/contact\" class=\"valtor-contact-btn\">\n      Nous contacter\n    </a>\n\n  </div>\n</section>\n\n<style>\n  .valtor-contact-simple {\n    background: #ffffff;\n    padding: 24px 16px;\n  }\n\n  .valtor-contact-container {\n    max-width: 920px;\n    margin: 0 auto;\n    background: #0a0a0a;\n    border: 1px solid rgba(74,157,196,0.35);\n    border-radius: 18px;\n    padding: 24px 28px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    box-shadow: 0 16px 38px rgba(0,0,0,0.12);\n  }\n\n  .valtor-contact-left {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n  }\n\n  .valtor-contact-icon {\n    width: 52px;\n    height: 52px;\n    border-radius: 50%;\n    background: rgba(74,157,196,0.14);\n    border: 1px solid rgba(74,157,196,0.45);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 25px;\n    flex-shrink: 0;\n  }\n\n  .valtor-contact-container h3 {\n    color: #ffffff;\n    font-size: 22px;\n    font-weight: 900;\n    margin: 0 0 6px;\n    line-height: 1.2;\n  }\n\n  .valtor-contact-container p {\n    color: rgba(255,255,255,0.78);\n    font-size: 15px;\n    margin: 0 0 10px;\n    line-height: 1.45;\n  }\n\n  .valtor-availability {\n    color: #ffffff;\n    font-size: 13px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .valtor-dot {\n    width: 9px;\n    height: 9px;\n    background: #4A9DC4;\n    border-radius: 50%;\n    display: inline-block;\n    box-shadow: 0 0 12px rgba(74,157,196,0.8);\n    animation: valtorPulse 1.4s infinite ease-in-out;\n  }\n\n  @keyframes valtorPulse {\n    0%, 100% {\n      opacity: 1;\n      transform: scale(1);\n    }\n    50% {\n      opacity: 0.45;\n      transform: scale(0.75);\n    }\n  }\n\n  .valtor-contact-btn {\n    background: #4A9DC4;\n    color: #0a0a0a;\n    text-decoration: none;\n    font-size: 14px;\n    font-weight: 900;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    padding: 14px 24px;\n    border-radius: 999px;\n    white-space: nowrap;\n    transition: 0.25s ease;\n  }\n\n  .valtor-contact-btn:hover {\n    background: #ffffff;\n    color: #0a0a0a;\n    transform: translateY(-2px);\n  }\n\n  @media screen and (max-width: 700px) {\n    .valtor-contact-container {\n      flex-direction: column;\n      text-align: center;\n      padding: 26px 18px;\n    }\n\n    .valtor-contact-left {\n      flex-direction: column;\n      gap: 14px;\n    }\n\n    .valtor-availability {\n      justify-content: center;\n      font-size: 12.5px;\n    }\n\n    .valtor-contact-btn {\n      width: 100%;\n      max-width: 260px;\n      text-align: center;\n    }\n  }\n</style>",
