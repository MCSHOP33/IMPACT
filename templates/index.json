96,0.18), transparent 30%),\n      #0a0a0a;\n    padding: 72px 18px;\n    overflow: hidden;\n  }\n\n  .valtor-ba-wrap {\n    max-width: 1220px;\n    margin: 0 auto;\n    position: relative;\n  }\n\n  .valtor-ba-grid {\n    display: grid;\n    grid-template-columns: 1.05fr 0.95fr;\n    align-items: center;\n    gap: 70px;\n  }\n\n  .valtor-ba-left {\n    min-height: 520px;\n    position: relative;\n  }\n\n  .valtor-image-stack {\n    position: relative;\n    width: 100%;\n    max-width: 530px;\n    height: 520px;\n    margin: 0 auto;\n  }\n\n  .valtor-photo {\n    position: absolute;\n    width: 265px;\n    height: 355px;\n    border-radius: 24px;\n    overflow: hidden;\n    background: #ffffff;\n    border: 1px solid rgba(74,157,196,0.38);\n    box-shadow:\n      0 28px 65px rgba(0,0,0,0.55),\n      0 0 35px rgba(74,157,196,0.18);\n    transition: 0.35s ease;\n  }\n\n  .valtor-photo img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  .valtor-photo-before {\n    top: 0;\n    left: 28px;\n    transform: rotate(-4deg);\n    z-index: 2;\n  }\n\n  .valtor-photo-after {\n    right: 8px;\n    bottom: 12px;\n    transform: rotate(4deg);\n    z-index: 3;\n  }\n\n  .valtor-label-before,\n  .valtor-label-after {\n    position: absolute;\n    z-index: 6;\n    color: #ffffff;\n    font-size: 20px;\n    font-weight: 700;\n    font-style: italic;\n    letter-spacing: 0.2px;\n    text-shadow: 0 0 12px rgba(0,0,0,0.65);\n    white-space: nowrap;\n  }\n\n  .valtor-label-before {\n    top: 86px;\n    left: 315px;\n    transform: rotate(8deg);\n  }\n\n  .valtor-label-after {\n    bottom: 104px;\n    left: 56px;\n    color: #4A9DC4;\n    transform: rotate(-5deg);\n  }\n\n  .valtor-ba-right {\n    color: #ffffff;\n    max-width: 540px;\n  }\n\n  .valtor-title {\n    color: #ffffff;\n    font-size: clamp(34px, 4vw, 54px);\n    line-height: 1.05;\n    margin: 0 0 36px;\n    font-weight: 900;\n    letter-spacing: -0.5px;\n  }\n\n  .valtor-stars {\n    color: #4A9DC4;\n    font-size: 34px;\n    letter-spacing: 4px;\n    margin-bottom: 24px;\n    line-height: 1;\n    text-shadow: 0 0 18px rgba(74,157,196,0.45);\n  }\n\n  .valtor-review {\n    color: rgba(255,255,255,0.92);\n    font-size: 20px;\n    line-height: 1.55;\n    font-weight: 600;\n    margin: 0;\n  }\n\n  .valtor-ba-nav {\n    position: absolute;\n    right: 390px;\n    bottom: 12px;\n    display: flex;\n    align-items: center;\n    gap: 18px;\n    color: #ffffff;\n    font-size: 16px;\n    font-weight: 800;\n  }\n\n  .valtor-ba-nav button {\n    width: 46px;\n    height: 46px;\n    border-radius: 999px;\n    border: 1px solid rgba(74,157,196,0.55);\n    background: rgba(74,157,196,0.10);\n    color: #ffffff;\n    font-size: 24px;\n    cursor: pointer;\n    transition: 0.25s ease;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .valtor-ba-nav button:hover {\n    background: #4A9DC4;\n    color: #0a0a0a;\n    transform: scale(1.06);\n  }\n\n  .valtor-current {\n    color: #4A9DC4;\n  }\n\n  .valtor-fade {\n    animation: valtorFade 0.45s ease;\n  }\n\n  @keyframes valtorFade {\n    from {\n      opacity: 0.25;\n      transform: translateX(16px);\n    }\n    to {\n      opacity: 1;\n      transform: translateX(0);\n    }\n  }\n\n  @media screen and (max-width: 900px) {\n    .valtor-ba-slider {\n      padding: 52px 14px 62px;\n    }\n\n    .valtor-ba-grid {\n      display: flex;\n      flex-direction: column;\n      gap: 26px;\n    }\n\n    .valtor-ba-left {\n      min-height: 420px;\n      width: 100%;\n    }\n\n    .valtor-image-stack {\n      max-width: 360px;\n      height: 420px;\n    }\n\n    .valtor-photo {\n      width: 190px;\n      height: 270px;\n      border-radius: 18px;\n    }\n\n    .valtor-photo-before {\n      left: 8px;\n      top: 0;\n    }\n\n    .valtor-photo-after {\n      right: 5px;\n      bottom: 12px;\n    }\n\n    .valtor-label-before {\n      top: 70px;\n      left: 190px;\n      font-size: 15px;\n    }\n\n    .valtor-label-after {\n      bottom: 92px;\n      left: 8px;\n      font-size: 15px;\n    }\n\n    .valtor-ba-right {\n      text-align: center;\n      max-width: 100%;\n    }\n\n    .valtor-title {\n      font-size: 34px;\n      margin-bottom: 20px;\n    }\n\n    .valtor-stars {\n      font-size: 27px;\n      margin-bottom: 18px;\n    }\n\n    .valtor-review {\n      font-size: 16px;\n      line-height: 1.55;\n      max-width: 92%;\n      margin: 0 auto;\n    }\n\n    .valtor-ba-nav {\n      position: static;\n      justify-content: center;\n      margin-top: 28px;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .valtor-image-stack {\n      max-width: 330px;\n      height: 395px;\n    }\n\n    .valtor-photo {\n      width: 175px;\n      height: 250px;\n    }\n\n    .valtor-label-before {\n      left: 174px;\n      font-size: 14px;\n    }\n\n    .valtor-label-after {\n      bottom: 88px;\n      font-size: 14px;\n    }\n\n    .valtor-title {\n      font-size: 30px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function initValtorSlider() {\n      var sliders = document.querySelectorAll('[data-valtor-slider]');\n\n      sliders.forEach(function(slider) {\n        if (slider.dataset.loaded === \"true\") return;\n        slider.dataset.loaded = \"true\";\n\n        var slides = [\n          {\n            before: \"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_16_juin_2026_15_00_32.png?v=1781614836\",\n            after: \"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_16_juin_2026_14_59_38.png?v=1781614808\",\n            beforeLabel: \"↢ Silhouette d’avant\",\n            afterLabel: \"À celle-ci ↝\",\n            title: \"Effet saisissant\",\n            review: \"“Je ne pensais pas voir une différence aussi nette. Mon ventre paraît plus plat, ma silhouette est mieux dessinée et je me sens beaucoup plus à l’aise.”\"\n          },\n          {\n            before: \"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_16_juin_2026_16_12_50.png?v=1781619227\",\n            after: \"https://cdn.shopify.com/s/files/1/0988/3995/3735/files/ChatGPT_Image_16_juin_2026_16_15_36.png?v=1781619344\",\n            beforeLabel: \"↢ Tenue normale\",\n            afterLabel: \"Avec VALTOR ↝\",\n            title: \"Invisible sous vos vêtements\",\n            review: \"“La différence reste discrète mais visible. Avec VALTOR, le rendu est plus propre, la silhouette est mieux tenue, et le tout reste totalement invisible sous un polo.”\"\n          }\n        ];\n\n        var index = 0;\n        var autoplayDelay = 4000;\n        var autoplay;\n\n        var beforeImg = slider.querySelector('.valtor-before-img');\n        var afterImg = slider.querySelector('.valtor-after-img');\n        var beforeLabel = slider.querySelector('.valtor-before-label');\n        var afterLabel = slider.querySelector('.valtor-after-label');\n        var title = slider.querySelector('.valtor-title');\n        var review = slider.querySelector('.valtor-review');\n        var current = slider.querySelector('.valtor-current');\n        var total = slider.querySelector('.valtor-total');\n        var prev = slider.querySelector('.valtor-prev');\n        var next = slider.querySelector('.valtor-next');\n        var grid = slider.querySelector('.valtor-ba-grid');\n\n        total.textContent = slides.length;\n\n        function updateSlide() {\n          var slide = slides[index];\n\n          beforeImg.src = slide.before;\n          afterImg.src = slide.after;\n          beforeImg.alt = slide.title + \" avant\";\n          afterImg.alt = slide.title + \" après\";\n          beforeLabel.textContent = slide.beforeLabel;\n          afterLabel.textContent = slide.afterLabel;\n          title.textContent = slide.title;\n          review.textContent = slide.review;\n          current.textContent = index + 1;\n\n          grid.classList.remove('valtor-fade');\n          void grid.offsetWidth;\n          grid.classList.add('valtor-fade');\n        }\n\n        function nextSlide() {\n          index = (index + 1) % slides.length;\n          updateSlide();\n        }\n\n        function prevSlide() {\n          index = (index - 1 + slides.length) % slides.length;\n          updateSlide();\n        }\n\n        function startAutoplay() {\n          stopAutoplay();\n          autoplay = setInterval(nextSlide, autoplayDelay);\n        }\n\n        function stopAutoplay() {\n          if (autoplay) clearInterval(autoplay);\n        }\n\n        next.addEventListener('click', function () {\n          nextSlide();\n          startAutoplay();\n        });\n\n        prev.addEventListener('click', function () {\n          prevSlide();\n          startAutoplay();\n        });\n\n        slider.addEventListener('mouseenter', stopAutoplay);\n        slider.addEventListener('mouseleave', startAutoplay);\n\n        updateSlide();\n        startAutoplay();\n      });\n    }\n\n    document.addEventListener('DOMContentLoaded', initValtorSlider);\n    document.addEventListener('shopify:section:load', initValtorSlider);\n    initValtorSlider();\n  })();\n</script>",
