age.setItem(keyTime, now);\n  el.textContent = stock;\n\n  // Diminue visuellement toutes les 3 à 7 minutes sur la page\n  function scheduleNext() {\n    const delay = (Math.floor(Math.random() * 4) + 3) * 60 * 1000;\n    setTimeout(function() {\n      if (stock > 5) {\n        stock--;\n        localStorage.setItem(key, stock);\n        el.textContent = stock;\n        el.classList.remove('vlt-stock-flash');\n        void el.offsetWidth;\n        el.classList.add('vlt-stock-flash');\n        scheduleNext();\n      }\n    }, delay);\n  }\n  scheduleNext();\n})();\n</script>"
